{
  "contractVersion": "1.0.0",
  "operations": [
    {
      "method": "post",
      "path": "/bugs",
      "operationId": "createBug",
      "summary": "Atomically create a Bug, first Occurrence, Event, and notification Outbox",
      "tag": "bugs",
      "security": "session-write",
      "status": 201,
      "versionControl": "none",
      "requestRef": "../schemas/bug.schema.json#/$defs/createBugRequest",
      "responseRef": "../schemas/bug.schema.json#/$defs/createBugResponse"
    },
    { "method": "get", "path": "/bugs", "operationId": "listBugs", "summary": "List visible Bugs with stable filtering and pagination", "tag": "bugs", "security": "session-read", "status": 200, "responseRef": "../schemas/bug.schema.json#/$defs/bugList" },
    { "method": "get", "path": "/bugs/{bugId}", "operationId": "getBug", "summary": "Get a visible Bug and current projection", "tag": "bugs", "security": "session-read", "status": 200, "responseRef": "../schemas/bug.schema.json#/$defs/bug" },
    { "method": "patch", "path": "/bugs/{bugId}", "operationId": "updateBug", "summary": "Update mutable Bug fields with optimistic locking", "tag": "bugs", "security": "session-write", "status": 200, "versionControl": "body", "requestRef": "../schemas/workflow.schema.json#/$defs/updateBugRequest", "responseRef": "../schemas/bug.schema.json#/$defs/bug" },
    { "method": "post", "path": "/bugs/{bugId}/transitions", "operationId": "transitionBug", "summary": "Execute a guarded Bug state transition", "tag": "bugs", "security": "session-write", "status": 200, "versionControl": "body", "requestRef": "../schemas/bug.schema.json#/$defs/transitionCommand", "responseRef": "../schemas/bug.schema.json#/$defs/bug" },
    { "method": "post", "path": "/bugs/{bugId}/occurrences", "operationId": "addOccurrence", "summary": "Append a concrete occurrence without semantic auto-merge", "tag": "occurrences", "security": "session-write", "status": 201, "versionControl": "body", "requestRef": "../schemas/workflow.schema.json#/$defs/addOccurrenceRequest", "responseRef": "../schemas/bug.schema.json#/$defs/occurrenceCreatedResponse" },
    { "method": "get", "path": "/bugs/{bugId}/duplicate-candidates", "operationId": "listDuplicateCandidates", "summary": "Return explained same-project duplicate candidates", "tag": "occurrences", "security": "session-read", "status": 200, "responseRef": "../schemas/bug.schema.json#/$defs/duplicateCandidateList" },
    { "method": "post", "path": "/bugs/{bugId}/mark-duplicate", "operationId": "markBugDuplicate", "summary": "Human-confirm a duplicate canonical Bug", "tag": "occurrences", "security": "session-write", "status": 200, "versionControl": "body", "requestRef": "../schemas/bug.schema.json#/$defs/transitionCommand", "responseRef": "../schemas/bug.schema.json#/$defs/bug" },
    { "method": "post", "path": "/bugs/{bugId}/repair-attempts", "operationId": "createRepairAttempt", "summary": "Create the next human, Relay, or external repair attempt", "tag": "repair-attempts", "security": "session-write", "status": 201, "versionControl": "body", "requestRef": "../schemas/bug.schema.json#/$defs/repairAttemptCreate", "responseRef": "../schemas/workflow.schema.json#/$defs/repairAttempt" },
    { "method": "post", "path": "/repair-attempts/{attemptId}/start", "operationId": "startRepairAttempt", "summary": "Start a planned repair attempt", "tag": "repair-attempts", "security": "session-write", "status": 200, "versionControl": "body", "requestRef": "../schemas/workflow.schema.json#/$defs/attemptCommand", "responseRef": "../schemas/workflow.schema.json#/$defs/repairAttempt" },
    { "method": "post", "path": "/repair-attempts/{attemptId}/deliver", "operationId": "deliverRepairAttempt", "summary": "Record authorized repair delivery evidence", "tag": "repair-attempts", "security": "session-write", "status": 200, "versionControl": "body", "requestRef": "../schemas/workflow.schema.json#/$defs/deliverAttemptRequest", "responseRef": "../schemas/workflow.schema.json#/$defs/repairAttempt" },
    { "method": "post", "path": "/repair-attempts/{attemptId}/fail", "operationId": "failRepairAttempt", "summary": "Fail an active repair attempt without losing history", "tag": "repair-attempts", "security": "session-write", "status": 200, "versionControl": "body", "requestRef": "../schemas/workflow.schema.json#/$defs/attemptReasonCommand", "responseRef": "../schemas/workflow.schema.json#/$defs/repairAttempt" },
    { "method": "post", "path": "/repair-attempts/{attemptId}/supersede", "operationId": "supersedeRepairAttempt", "summary": "Supersede an attempt before changing repair mode", "tag": "repair-attempts", "security": "session-write", "status": 200, "versionControl": "body", "requestRef": "../schemas/workflow.schema.json#/$defs/attemptReasonCommand", "responseRef": "../schemas/workflow.schema.json#/$defs/repairAttempt" },
    { "method": "post", "path": "/repair-attempts/{attemptId}/dispatch/relay", "operationId": "dispatchRepairAttemptToRelay", "summary": "Durably enqueue a versioned Relay handoff", "tag": "relay", "security": "session-write", "status": 202, "versionControl": "body", "requestRef": "../schemas/workflow.schema.json#/$defs/dispatchRelayRequest", "responseRef": "../schemas/common.schema.json#/$defs/acceptedResult" },
    { "method": "post", "path": "/repair-attempts/{attemptId}/continue-relay", "operationId": "continueRelayRepairAttempt", "summary": "Idempotently continue the bound Relay task after a failed verification", "tag": "relay", "security": "session-write", "status": 202, "versionControl": "body", "requestRef": "../schemas/workflow.schema.json#/$defs/continueRelayRequest", "responseRef": "../schemas/common.schema.json#/$defs/acceptedResult" },
    { "method": "post", "path": "/bugs/{bugId}/verifications", "operationId": "createVerification", "summary": "Create verification for the latest eligible delivered attempt and build", "tag": "verifications", "security": "session-write", "status": 201, "versionControl": "body", "requestRef": "../schemas/workflow.schema.json#/$defs/createVerificationRequest", "responseRef": "../schemas/workflow.schema.json#/$defs/verification" },
    { "method": "post", "path": "/verifications/{verificationId}/start", "operationId": "startVerification", "summary": "Claim and start a verification", "tag": "verifications", "security": "session-write", "status": 200, "versionControl": "body", "requestRef": "../schemas/workflow.schema.json#/$defs/attemptCommand", "responseRef": "../schemas/workflow.schema.json#/$defs/verification" },
    { "method": "post", "path": "/verifications/{verificationId}/result", "operationId": "recordVerificationResult", "summary": "Record a human pass, fail, or blocked result", "tag": "verifications", "security": "session-write", "status": 200, "versionControl": "body", "requestRef": "../schemas/bug.schema.json#/$defs/verificationResult", "responseRef": "../schemas/workflow.schema.json#/$defs/verificationResultResponse" },
    { "method": "post", "path": "/uploads/init", "operationId": "initUpload", "summary": "Create or resume a quarantined upload session", "tag": "uploads", "security": "session-write", "status": 201, "versionControl": "none", "requestRef": "../schemas/upload.schema.json#/$defs/initRequest", "responseRef": "../schemas/upload.schema.json#/$defs/initResponse" },
    { "method": "put", "path": "/uploads/{sessionId}/chunks/{chunkNumber}", "operationId": "putUploadChunk", "summary": "Stream one validated upload chunk", "tag": "uploads", "security": "session-write", "status": 204, "versionControl": "header", "requestContent": "application/octet-stream" },
    { "method": "post", "path": "/uploads/{sessionId}/finalize", "operationId": "finalizeUpload", "summary": "Validate and content-address a complete quarantined upload", "tag": "uploads", "security": "session-write", "status": 200, "versionControl": "body", "requestRef": "../schemas/upload.schema.json#/$defs/finalizeRequest", "responseRef": "../schemas/upload.schema.json#/$defs/finalizeResponse" },
    { "method": "get", "path": "/attachments/{attachmentId}", "operationId": "getAttachment", "summary": "Authorize and stream or safely download evidence", "tag": "uploads", "security": "session-read", "status": 200, "responseContent": "application/octet-stream" },
    { "method": "get", "path": "/bugs/{bugId}/events", "operationId": "listBugEvents", "summary": "List immutable Bug timeline events", "tag": "events", "security": "session-read", "status": 200, "responseRef": "../schemas/api.schema.json#/$defs/eventList" },
    { "method": "get", "path": "/events/stream", "operationId": "streamEvents", "summary": "Stream authorized QA Hub event projections", "tag": "events", "security": "session-read", "status": 200, "responseContent": "text/event-stream" },
    { "method": "get", "path": "/notifications", "operationId": "listNotifications", "summary": "List durable in-app Inbox notifications", "tag": "notifications", "security": "session-read", "status": 200, "responseRef": "../schemas/notification.schema.json#/$defs/notificationList" },
    { "method": "post", "path": "/notifications/{notificationId}/read", "operationId": "markNotificationRead", "summary": "Mark an Inbox notification read", "tag": "notifications", "security": "session-write", "status": 200, "versionControl": "body", "requestRef": "../schemas/notification.schema.json#/$defs/readRequest", "responseRef": "../schemas/notification.schema.json#/$defs/notification" },
    { "method": "post", "path": "/push/subscriptions", "operationId": "createPushSubscription", "summary": "Register a non-shared-device Web Push subscription", "tag": "notifications", "security": "session-write", "status": 201, "versionControl": "none", "requestRef": "../schemas/notification.schema.json#/$defs/pushSubscriptionRequest", "responseRef": "../schemas/notification.schema.json#/$defs/pushSubscriptionResponse" },
    { "method": "get", "path": "/projects/{projectId}/builds", "operationId": "listProjectBuilds", "summary": "List project Builds and exact commit identities", "tag": "builds", "security": "session-read", "status": 200, "responseRef": "../schemas/build.schema.json#/$defs/buildList" },
    { "method": "post", "path": "/projects/{projectId}/builds", "operationId": "registerBuild", "summary": "Register or ingest a Build with provider identity", "tag": "builds", "security": "session-write", "status": 201, "versionControl": "none", "requestRef": "../schemas/build.schema.json#/$defs/registrationRequest", "responseRef": "../schemas/build.schema.json#/$defs/build" },
    { "method": "post", "path": "/builds/{buildId}/link-repair", "operationId": "linkBuildRepair", "summary": "Auditably prove Build inclusion of an exact delivered commit", "tag": "builds", "security": "session-write", "status": 200, "versionControl": "body", "requestRef": "../schemas/build.schema.json#/$defs/linkRepairRequest", "responseRef": "../schemas/build.schema.json#/$defs/build" },
    { "method": "post", "path": "/integrations/relay/webhooks", "operationId": "receiveRelayWebhook", "summary": "Authenticate and durably deduplicate a Relay integration event", "tag": "integrations", "security": "relay-webhook", "status": 202, "versionControl": "none", "requestRef": "../schemas/relay.schema.json#/$defs/webhook", "responseRef": "../schemas/common.schema.json#/$defs/acceptedResult" },
    { "method": "post", "path": "/integrations/build/webhooks", "operationId": "receiveBuildWebhook", "summary": "Authenticate and durably deduplicate a Build provider event", "tag": "integrations", "security": "build-webhook", "status": 202, "versionControl": "none", "requestRef": "../schemas/build.schema.json#/$defs/providerWebhook", "responseRef": "../schemas/common.schema.json#/$defs/acceptedResult" },
    { "method": "get", "path": "/health/live", "operationId": "getLiveHealth", "summary": "Return process liveness only", "tag": "health", "security": "none", "status": 200, "responseRef": "../schemas/api.schema.json#/$defs/liveHealth" },
    { "method": "get", "path": "/health/ready", "operationId": "getReadyHealth", "summary": "Return request-serving readiness", "tag": "health", "security": "none", "status": 200, "responseRef": "../schemas/api.schema.json#/$defs/readyHealth" },
    { "method": "get", "path": "/health/deps", "operationId": "getDependencyHealth", "summary": "Return authorized dependency readiness detail", "tag": "health", "security": "session-read", "status": 200, "responseRef": "../schemas/api.schema.json#/$defs/dependencyHealth" }
  ]
}
