{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-hub.local/contracts/build.schema.json",
  "title": "QA Hub Build identity contracts",
  "$defs": {
    "buildStatus": {
      "type": "string",
      "enum": ["registered", "queued", "building", "validating", "publishing", "ready", "failed"]
    },
    "buildMode": {
      "type": "string",
      "enum": ["full", "hot_update", "cdn", "debug", "other"]
    },
    "registrationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "externalId",
        "version",
        "channel",
        "projectKey",
        "branch",
        "sourceCommitSha",
        "mode",
        "status",
        "manifest"
      ],
      "properties": {
        "provider": { "type": "string", "enum": ["manual", "ozdqp", "custom"] },
        "externalId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "channel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "projectKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sourceCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "mode": { "$ref": "#/$defs/buildMode" },
        "status": { "$ref": "#/$defs/buildStatus" },
        "resourceVersion": { "type": ["string", "null"], "maxLength": 100 },
        "downloadUrl": { "type": ["string", "null"], "format": "uri" },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commitShas"],
          "properties": {
            "commitShas": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            },
            "artifactSha256": { "$ref": "https://qa-hub.local/contracts/common.schema.json#/$defs/sha256" },
            "providerPayloadDigest": { "$ref": "https://qa-hub.local/contracts/common.schema.json#/$defs/sha256" }
          }
        }
      }
    },
    "linkRepairRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedVersion", "repairAttemptId", "deliveredCommitSha", "evidenceType"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 1 },
        "repairAttemptId": { "$ref": "https://qa-hub.local/contracts/common.schema.json#/$defs/uuid" },
        "deliveredCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "evidenceType": { "type": "string", "enum": ["manifest", "release_manager_override"] },
        "overrideReason": { "type": "string", "minLength": 1, "maxLength": 5000 }
      },
      "allOf": [
        {
          "if": { "properties": { "evidenceType": { "const": "release_manager_override" } }, "required": ["evidenceType"] },
          "then": { "required": ["overrideReason"] }
        }
      ]
    },
    "providerWebhook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "provider",
        "eventId",
        "deliveryId",
        "externalId",
        "projectKey",
        "branch",
        "sourceCommitSha",
        "mode",
        "status",
        "occurredAt",
        "payload"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "provider": { "type": "string", "enum": ["ozdqp", "custom"] },
        "eventId": { "$ref": "https://qa-hub.local/contracts/common.schema.json#/$defs/uuid" },
        "deliveryId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "externalId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "projectKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sourceCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "mode": { "$ref": "#/$defs/buildMode" },
        "status": { "$ref": "#/$defs/buildStatus" },
        "occurredAt": { "$ref": "https://qa-hub.local/contracts/common.schema.json#/$defs/dateTime" },
        "payload": { "type": "object", "additionalProperties": true }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectId",
        "provider",
        "externalId",
        "versionName",
        "channel",
        "projectKey",
        "branch",
        "sourceCommitSha",
        "mode",
        "status",
        "manifest",
        "version"
      ],
      "properties": {
        "id": { "$ref": "https://qa-hub.local/contracts/common.schema.json#/$defs/uuid" },
        "projectId": { "$ref": "https://qa-hub.local/contracts/common.schema.json#/$defs/uuid" },
        "provider": { "type": "string", "enum": ["manual", "ozdqp", "custom"] },
        "externalId": { "type": "string", "minLength": 1, "maxLength": 300 },
        "versionName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "channel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "projectKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}$" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 300 },
        "sourceCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "mode": { "$ref": "#/$defs/buildMode" },
        "status": { "$ref": "#/$defs/buildStatus" },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commitShas"],
          "properties": {
            "commitShas": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            },
            "artifactSha256": { "$ref": "https://qa-hub.local/contracts/common.schema.json#/$defs/sha256" }
          }
        },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "buildList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "nextCursor"],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/build" } },
        "nextCursor": { "type": ["string", "null"], "maxLength": 500 }
      }
    }
  }
}
