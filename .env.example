# Bind all local interfaces for phone/Web LAN access; constrain exposure with
# scripts/Enable-QAHubLanAccess.ps1 rather than opening the whole Public profile.
QA_HUB_API_HOST=0.0.0.0
QA_HUB_API_PORT=4320
QA_HUB_DATA_ROOT=D:\Relay-QA-Hub-Data\production
QA_HUB_SOURCE_ROOT=D:\Relay-QA-Hub
# Session is the fail-closed default. Inject access/session secrets at runtime; never commit them.
# QA_HUB_MVP_ACCESS_TOKEN=
QA_HUB_WEB_AUTH_MODE=session
# QA_HUB_WEB_SESSION_SECRET=
# Optional only for the first local administrator bootstrap.
# QA_HUB_BOOTSTRAP_ADMIN_PASSWORD=
# Comma-separated exact Web origins accepted for login and CSRF-protected writes.
QA_HUB_WEB_ORIGINS=http://127.0.0.1:4174,http://10.100.5.157:4174
QA_HUB_WEB_SECURE_COOKIE=false
# Optional override. Default: apps/android/config/qa-people.json
# QA_HUB_PEOPLE_CONFIG_FILE=D:\Relay-QA-Hub\apps\android\config\qa-people.json
# Optional Relay executor. QA Hub remains the sole fact source; the URL must
# be loopback HTTP and credentials stay in an ACL-protected runtime file.
# QA_HUB_RELAY_M2M_URL=http://127.0.0.1:4317/api/integrations/qa/v1/handoffs
# QA_HUB_RELAY_M2M_TOKEN_FILE=C:\ProgramData\Relay\secrets\qa-hub-m2m.token
# QA_HUB_RELAY_INSTANCE_ID=relay-main
# QA_HUB_RELAY_QA_INSTANCE_ID=qa-local
# QA_HUB_RELAY_PRINCIPAL_ID=10000000-0000-4000-8000-000000000008
# QA_HUB_RELAY_WEBHOOK_SECRET_FILE=C:\ProgramData\Relay\secrets\qa-hub-webhook.secret

# Readiness probe bounds. The write probe creates and deletes a tiny file in each evidence root.
QA_HUB_HEALTH_PROBE_TIMEOUT_MS=2000
QA_HUB_EVIDENCE_MIN_FREE_BYTES=536870912
QA_HUB_SQLITE_WAL=true
QA_HUB_SQLITE_BUSY_TIMEOUT_MS=5000
# Production data/configuration stay outside every source checkout.
QA_HUB_PEOPLE_CONFIG_FILE=D:\Relay-QA-Hub-Config\qa-people.json
# The API takes a WAL-safe online snapshot through its existing SQLite worker,
# then publishes the manifest-bound database plus referenced attachments to E:.
QA_HUB_BACKUP_ROOT=D:\Relay-QA-Hub-Backups\production
QA_HUB_BACKUP_ON_START=true
QA_HUB_BACKUP_INTERVAL_MINUTES=15
QA_HUB_BACKUP_ARCHIVE_ENABLED=true
QA_HUB_BACKUP_ARCHIVE_ROOT=E:\Relay-QA-Hub-Archives\production
QA_HUB_WORKER_POLL_INTERVAL_MS=1000
# Android clients check this public feed on launch. The APK is published first
# and latest.json is replaced last. Default: <QA_HUB_DATA_ROOT>\android-updates\stable
# QA_HUB_ANDROID_UPDATE_ROOT=D:\Relay-QA-Hub-Data\production\android-updates\stable
QA_HUB_BUILD_SHA=dev
QA_HUB_LOG_LEVEL=info
