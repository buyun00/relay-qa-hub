{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "src/**/*.cts"]
}
